<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Ambiente 4x2: el fondo es la caratula desenfocada (lo pinta PintorDeWidgets). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.LifeMusic">

    <ImageView
        android:id="@+id/widget_fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fondo_inicial" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_caratula"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/album_art"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_caratula_inicial" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_saludo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/widget_marca"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/not_playing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_play"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progreso_ambiente" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_boton_me_gusta"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_vidrio_circulo"
                android:contentDescription="@string/like">

                <ImageView
                    android:id="@+id/widget_icono_me_gusta"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/favorite_border" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_boton_anterior"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_vidrio_circulo"
                android:contentDescription="@string/widget_anterior">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/skip_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_boton_play"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/play_pause">

                <ImageView
                    android:id="@+id/widget_fondo_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_play_redondo" />

                <ImageView
                    android:id="@+id/widget_icono_play"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_boton_siguiente"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_vidrio_circulo"
                android:contentDescription="@string/widget_siguiente">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/skip_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
